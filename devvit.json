{
	"$schema": "https://developers.reddit.com/schema/config-file.v1.json",
	"name": "chess-war",
	"post": {
		"dir": "dist/client",
		"entrypoints": {
			"default": {
				"entry": "splash.html",
				"inline": true
			},
			"game": {
				"entry": "index.html"
			},
			"creator": {
				"entry": "creator.html",
				"inline": true
			}
		}
	},
	"server": {
		"dir": "dist/server",
		"entry": "index.cjs"
	},
	"menu": {
		"items": [
			{
				"label": "📅 Post Daily Challenge",
				"description": "Create a new daily chess puzzle challenge",
				"location": "subreddit",
				"forUserType": "moderator",
				"endpoint": "/internal/menu/daily-challenge-create"
			},
			{
				"label": "🎨 Post Level Creator",
				"description": "Create a post where users can build custom puzzles",
				"location": "subreddit",
				"forUserType": "moderator",
				"endpoint": "/internal/menu/level-creator-create"
			}
		]
	},
	"triggers": {
		"onAppInstall": "/internal/on-app-install"
	},
	"dev": {
		"subreddit": "chess_war_dev"
	}
}
